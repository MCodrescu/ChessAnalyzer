# No API key. Install the OS package with: sudo apt-get install -y stockfish
# Optional trusted executable path. Blank discovers PATH and /usr/games/stockfish.
STOCKFISH_PATH=
# Blank values use defaults centralized in src/chess_analyzer/config.py.
# Depth cap (default 12), not necessarily reached before the time cap.
STOCKFISH_DEPTH=
# Per-position search cap in seconds (default 0.2); "none" selects depth-only.
STOCKFISH_TIME_SECONDS=
# Startup/protocol timeout allowance (default 10 seconds), NOT search duration.
STOCKFISH_TIMEOUT_SECONDS=
# Search threads (default 1) and hash table MiB (default 64), per client process.
STOCKFISH_THREADS=
STOCKFISH_HASH_MB=

# Django reads the process environment, not this file automatically.
# These development values are not suitable for a deployed web service.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
# Enable only behind a trusted HTTPS-terminating proxy such as App Platform.
DJANGO_TRUST_PROXY=0
# Both credentials are required with DJANGO_DEBUG=0. Use a strong unique password.
DJANGO_BASIC_AUTH_USERNAME=
DJANGO_BASIC_AUTH_PASSWORD=